#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Security Guard
# Blocks commits containing database connection strings, passwords, or tokens
# ==============================================================================
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# 1. Block prohibited credential files from ever being staged
STAGED_FILES=$(git diff --cached --name-only)
for f in $STAGED_FILES; do
    if [[ "$f" =~ (db_config.*\.json|\.vault\.enc|antigravity-oauth-token|oauth_creds\.json|google_accounts\.json|\.env) ]]; then
        echo -e "\n${BOLD}${RED}✖ COMMIT BLOCKED BY SECURITY GUARD!${NC}"
        echo -e "Attempted to stage protected credential file: ${BOLD}${f}${NC}"
        echo "Local tokens and database configs must NEVER be committed to GitHub."
        echo "Unstage with: git reset HEAD \"$f\""
        exit 1
    fi
done

# 2. Block plaintext database connection strings with passwords in staged diffs
if git diff --cached -U0 | grep -iE '^\+[^+].*(postgresql|postgres)://[^:]+:[^@]+@' >/dev/null 2>&1; then
    echo -e "\n${BOLD}${RED}✖ COMMIT BLOCKED BY SECURITY GUARD!${NC}"
    echo -e "Plaintext database connection string with password detected in staged changes."
    echo "Please remove credentials or use environment variables before committing."
    exit 1
fi

exit 0
