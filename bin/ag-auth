#!/usr/bin/env bash
# ==============================================================================
# ag-auth: Universal Antigravity Multi-Account Session Vault & Token Switcher
# Seamlessly switch between multiple Google accounts on Antigravity CLI (agy),
# Antigravity IDE, and Antigravity 2.0 Desktop across macOS, Linux, and Windows.
# Features:
#   • Multi-surface switching (CLI, IDE, 2.0 Desktop App)
#   • Cross-platform compatibility (macOS, Linux, Windows Git Bash / WSL / native)
#   • Friction-free Cloud Database & Team Vault Sync (Supabase, Custom REST, Drive)
#   • Zero-Knowledge Client-Side AES-256-CBC Encryption for shared team tokens
#   • Tab autocompletion for bash, zsh, fish, and PowerShell
#   • Real-time AI quota monitoring (Gemini & Claude limits) & token auto-refresh
#   • Interactive arrow-key account picker (↑/↓ + Enter) & quick '@' shortcut
# ==============================================================================
set -euo pipefail

VERSION="1.5.0"

# ------------------------------------------------------------------------------
# 1. Cross-Platform OS & Path Resolution
# ------------------------------------------------------------------------------
OS_TYPE="$(uname -s 2>/dev/null || echo "Windows_NT")"
case "${OS_TYPE}" in
    Darwin*)
        PLATFORM="macos"
        GEMINI_DIR="${HOME}/.gemini"
        IDE_STORAGE="${HOME}/Library/Application Support/Antigravity IDE/User/globalStorage/state.vscdb"
        APP_STORAGE="${HOME}/Library/Application Support/Antigravity/User/globalStorage/state.vscdb"
        ;;
    Linux*)
        PLATFORM="linux"
        GEMINI_DIR="${HOME}/.gemini"
        XDG_CONF="${XDG_CONFIG_HOME:-${HOME}/.config}"
        IDE_STORAGE="${XDG_CONF}/Antigravity IDE/User/globalStorage/state.vscdb"
        APP_STORAGE="${XDG_CONF}/Antigravity/User/globalStorage/state.vscdb"
        ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
        PLATFORM="windows"
        WIN_APPDATA="${APPDATA:-$USERPROFILE/AppData/Roaming}"
        GEMINI_DIR="${USERPROFILE:-$HOME}/.gemini"
        IDE_STORAGE="${WIN_APPDATA}/Antigravity IDE/User/globalStorage/state.vscdb"
        APP_STORAGE="${WIN_APPDATA}/Antigravity/User/globalStorage/state.vscdb"
        ;;
    *)
        PLATFORM="unix"
        GEMINI_DIR="${HOME}/.gemini"
        IDE_STORAGE="${HOME}/.config/Antigravity IDE/User/globalStorage/state.vscdb"
        APP_STORAGE="${HOME}/.config/Antigravity/User/globalStorage/state.vscdb"
        ;;
esac

CLI_DIR="${GEMINI_DIR}/antigravity-cli"
ACTIVE_TOKEN="${CLI_DIR}/antigravity-oauth-token"
