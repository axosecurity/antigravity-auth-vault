#!/usr/bin/env bash
# ==============================================================================
# Universal Antigravity Multi-Account Session Vault (CLI Launcher)
# Pure JavaScript / Node.js Engine (macOS, Linux, Windows)
# ==============================================================================
set -e

# Canonical symlink resolution (supports nested symlinks)
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

if ! command -v node >/dev/null 2>&1; then
    echo "Error: Node.js is required to run ag-auth. Please install Node.js (https://nodejs.org)." >&2
    exit 1
fi

# If invoked directly via the '@' shortcut/symlink, pass '@' as the first argument
if [[ "$(basename "$0")" == "@" ]]; then
    exec node "${SCRIPT_DIR}/ag-auth.js" "@" "$@"
else
    exec node "${SCRIPT_DIR}/ag-auth.js" "$@"
fi
