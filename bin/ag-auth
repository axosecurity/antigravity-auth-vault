CACHE_TTL = 180  # 3 minutes cache

# --- Zero-Knowledge Client-Side Encryption (AES-256-CBC via OpenSSL PBKDF2) ---
def encrypt_str(plain_str, passphrase):
    p = subprocess.Popen(
        ['openssl', 'enc', '-aes-256-cbc', '-pbkdf2', '-iter', '100000', '-pass', f'pass:{passphrase}', '-base64', '-A'],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    out, err = p.communicate(plain_str.encode('utf-8'))
    if p.returncode != 0: raise RuntimeError(err.decode().strip() or "Encryption failed")
    return out.decode('utf-8')

def decrypt_str(enc_str, passphrase):
    p = subprocess.Popen(
        ['openssl', 'enc', '-d', '-aes-256-cbc', '-pbkdf2', '-iter', '100000', '-pass', f'pass:{passphrase}', '-base64', '-A'],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    out, err = p.communicate(enc_str.encode('utf-8'))
    if p.returncode != 0: raise RuntimeError(err.decode().strip() or "Decryption failed: bad passphrase or corrupt data")
    return out.decode('utf-8')

# --- Remote Database & Team Vault Providers ---
def get_db_config(vault_dir):
    cfg_path = os.path.join(vault_dir, 'db_config.json')
    if os.path.exists(cfg_path):
        try:
            with open(cfg_path) as f:
                return json.load(f)
        except Exception:
            return None
    return None

def save_db_config(vault_dir, config):
    cfg_path = os.path.join(vault_dir, 'db_config.json')
    with open(cfg_path, 'w') as f:
        json.dump(config, f, indent=2)
    try:
        os.chmod(cfg_path, 0o600)
    except Exception:
        pass

def print_supabase_sql_snippet():
    print(f"""
{YELLOW}Notice:{NC} The table '{BOLD}antigravity_vault{NC}' was not found in your Supabase project.
To create it in 5 seconds:
1. Open your Supabase Dashboard ➔ {BOLD}SQL Editor{NC}
2. Paste and run this SQL snippet:

{CYAN}CREATE TABLE IF NOT EXISTS antigravity_vault (
    email TEXT PRIMARY KEY,
    enc_payload TEXT NOT NULL,
    updated_by TEXT NOT NULL,
    last_synced_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Allow anonymous team read/write (protected by client-side AES-256):
ALTER TABLE antigravity_vault ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Allow team sync" ON antigravity_vault FOR ALL USING (true) WITH CHECK (true);{NC}
""")

def db_api_fetch(config):
    provider = config.get('provider')
    if provider == 'file-share':
        share_dir = os.path.expanduser(config.get('path', ''))
        if not os.path.exists(share_dir):
            return []
        rows = []
        for fn in sorted(os.listdir(share_dir)):
            if fn.endswith('.vault.enc'):
                fp = os.path.join(share_dir, fn)
                with open(fp) as f:
                    rows.append(json.load(f))
        return rows
    elif provider == 'supabase':
        ep = config.get('endpoint', '').rstrip('/')
        key = config.get('api_key', '')
        tbl = config.get('table', 'antigravity_vault')
        url = f"{ep}/rest/v1/{tbl}?select=email,enc_payload,updated_by,last_synced_at"
        req = urllib.request.Request(url, headers={
            'apikey': key,
            'Authorization': f'Bearer {key}',
            'Content-Type': 'application/json'
        })
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                return json.loads(resp.read().decode('utf-8'))
        except urllib.error.HTTPError as e:
            err_msg = e.read().decode('utf-8', errors='ignore')
            if 'relation' in err_msg or 'PGRST205' in err_msg or e.code == 404:
                raise RuntimeError("table_not_found")
            raise RuntimeError(f"Supabase HTTP {e.code}: {err_msg}")
    elif provider == 'custom-http':
        url = config.get('endpoint', '')
        key = config.get('api_key', '')
        hdrs = {'Content-Type': 'application/json'}
        if key: hdrs['Authorization'] = f'Bearer {key}'
        req = urllib.request.Request(url, headers=hdrs)
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode('utf-8'))
    return []

def db_api_upsert(config, records):
    provider = config.get('provider')
    if provider == 'file-share':
        share_dir = os.path.expanduser(config.get('path', ''))
        os.makedirs(share_dir, exist_ok=True)
        for r in records:
            email = r['email']
            fp = os.path.join(share_dir, f"{email}.vault.enc")
            with open(fp, 'w') as f:
                json.dump(r, f, indent=2)
        return True
    elif provider == 'supabase':
        ep = config.get('endpoint', '').rstrip('/')
        key = config.get('api_key', '')
        tbl = config.get('table', 'antigravity_vault')
        url = f"{ep}/rest/v1/{tbl}"
        req = urllib.request.Request(url, data=json.dumps(records).encode('utf-8'), headers={
            'apikey': key,
            'Authorization': f'Bearer {key}',
            'Content-Type': 'application/json',
            'Prefer': 'resolution=merge-duplicates'
        }, method='POST')
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                return True
        except urllib.error.HTTPError as e:
            err_msg = e.read().decode('utf-8', errors='ignore')
            if 'relation' in err_msg or 'PGRST205' in err_msg or e.code == 404:
                raise RuntimeError("table_not_found")
            raise RuntimeError(f"Supabase HTTP {e.code}: {err_msg}")
    elif provider == 'custom-http':
        url = config.get('endpoint', '')
        key = config.get('api_key', '')
        hdrs = {'Content-Type': 'application/json'}
        if key: hdrs['Authorization'] = f'Bearer {key}'
        req = urllib.request.Request(url, data=json.dumps(records).encode('utf-8'), headers=hdrs, method='POST')
        with urllib.request.urlopen(req, timeout=15) as resp:
            return True
    return False

def cli_db_setup(vault_dir):
    print(f"{BOLD}{MAGENTA}======================================================{NC}")
    print(f"{BOLD}{MAGENTA}  Universal Antigravity Team Vault & Database Setup   {NC}")
    print(f"{BOLD}{MAGENTA}======================================================{NC}\n")
    print("Choose your Remote Database / Vault Provider:")
    print("  1) Supabase (Free cloud Postgres REST, instant 30s setup, recommended)")
    print("  2) Shared Cloud Drive / Folder (Dropbox, Google Drive, iCloud, NFS)")
    print("  3) Custom HTTP REST API (Cloudflare Worker, Next.js, FastAPI, etc.)")
    print()
    choice = input("Select an option [1-3] (default: 1): ").strip() or "1"

    config = {}
    if choice == "1":
        config['provider'] = 'supabase'
        config['endpoint'] = input("Enter Supabase Project URL (e.g. https://xyz.supabase.co): ").strip()
        config['api_key'] = input("Enter Supabase API Key (anon public or service_role): ").strip()
        tbl = input("Enter Table name (default: antigravity_vault): ").strip() or "antigravity_vault"
        config['table'] = tbl
    elif choice == "2":
        config['provider'] = 'file-share'
        config['path'] = input("Enter Shared Folder path (e.g. ~/Dropbox/TeamVault or /Volumes/Share): ").strip()
    elif choice == "3":
        config['provider'] = 'custom-http'
        config['endpoint'] = input("Enter REST Endpoint URL: ").strip()
        config['api_key'] = input("Enter Optional Bearer Token (press Enter if none): ").strip()
    else:
        print(f"{RED}Invalid choice.{NC}")
        return

    print()
    passphrase = input("Enter Team Encryption Passphrase (shared with your team): ").strip()
    while not passphrase:
        passphrase = input("Passphrase cannot be empty. Enter Team Encryption Passphrase: ").strip()
    config['passphrase'] = passphrase

    save_db_config(vault_dir, config)
    print(f"\n{GREEN}✔ Database configuration saved to {os.path.join(vault_dir, 'db_config.json')} (chmod 600){NC}")

    print(f"\n{CYAN}Testing remote connection...{NC}")
    try:
        rows = db_api_fetch(config)
        print(f"{GREEN}✔ Connected successfully! Remote profiles found: {len(rows)}{NC}")
    except RuntimeError as e:
        if str(e) == 'table_not_found':
            print_supabase_sql_snippet()
        else:
            print(f"{YELLOW}Warning during connection test: {e}{NC}")

    push_now = input("\nWould you like to push your existing local accounts to the team vault now? [Y/n]: ").strip().lower()
    if push_now in ('', 'y', 'yes'):
        cli_db_push(vault_dir)

    print(f"\n{GREEN}✔ Setup complete!{NC}")
    print(f"Run '{BOLD}ag-auth db sync{NC}' anytime to sync accounts with your team.")

def cli_db_status(vault_dir):
    config = get_db_config(vault_dir)
    if not config:
        print(f"{YELLOW}Status:{NC} Disconnected (No remote database configured).")
        print(f"Run '{BOLD}ag-auth db setup{NC}' to connect a team vault or Supabase.")
        return

    print(f"{BOLD}{MAGENTA}========================================{NC}")
    print(f"{BOLD}{MAGENTA}  Universal Antigravity Team Vault Status{NC}")
    print(f"{BOLD}{MAGENTA}========================================{NC}")
    print(f"Provider:  {BOLD}{config.get('provider')}{NC}")
    if config.get('endpoint'):
        print(f"Endpoint:  {config.get('endpoint')}")
    if config.get('path'):
        print(f"Path:      {config.get('path')}")
    if config.get('table'):
        print(f"Table:     {config.get('table')}")
    print(f"Security:  {GREEN}AES-256 Zero-Knowledge Client-Side Encryption{NC}")

    print(f"\n{CYAN}Testing remote connection...{NC}")
    try:
        rows = db_api_fetch(config)
        print(f"{GREEN}✔ Connection healthy!{NC}")
        print(f"Remote Profiles: {BOLD}{len(rows)}{NC}")
        for r in rows:
            synced_at = r.get('last_synced_at', 'unknown')
            updater = r.get('updated_by', 'unknown')
            print(f"  • {r.get('email')} {DIM}(last synced: {synced_at}, by {updater}){NC}")
    except RuntimeError as e:
        if str(e) == 'table_not_found':
            print_supabase_sql_snippet()
        else:
            print(f"{RED}Connection failed:{NC} {e}")

def cli_db_push(vault_dir):
    config = get_db_config(vault_dir)
    if not config:
        print(f"{RED}Error:{NC} No database connected. Run '{BOLD}ag-auth db setup{NC}' first.")
        sys.exit(1)
    passphrase = config.get('passphrase')
    if not passphrase:
        print(f"{RED}Error:{NC} No encryption passphrase configured in db_config.json.")
        sys.exit(1)
    profiles_dir = os.path.join(vault_dir, 'profiles')
    if not os.path.exists(profiles_dir):
        print(f"{YELLOW}No local profiles found to push.{NC}")
        return

    records = []
    import socket
    who = os.getenv('USER') or os.getenv('USERNAME') or 'developer'
    host = socket.gethostname()
    updater = f"{who}@{host}"

    for d in sorted(os.listdir(profiles_dir)):
        p = os.path.join(profiles_dir, d)
        token_path = os.path.join(p, 'antigravity-oauth-token')
        if os.path.isdir(p) and os.path.exists(token_path):
            payload = {'email': d, 'files': {}}
            for fn in os.listdir(p):
                fp = os.path.join(p, fn)
                if os.path.isfile(fp) and not fn.endswith('.tmp'):
                    with open(fp, 'r', errors='ignore') as f:
                        payload['files'][fn] = f.read()
            try:
                enc = encrypt_str(json.dumps(payload), passphrase)
                records.append({
                    'email': d,
                    'enc_payload': enc,
                    'updated_by': updater,
                    'last_synced_at': datetime.datetime.now(datetime.timezone.utc).isoformat()
                })
            except Exception as e:
                print(f"{RED}Failed to encrypt profile {d}:{NC} {e}")

    if not records:
        print(f"{YELLOW}No valid profiles found to push.{NC}")
        return

    print(f"{CYAN}Pushing {len(records)} encrypted profile(s) to remote database ({config.get('provider')})...{NC}")
    try:
        db_api_upsert(config, records)
        print(f"{GREEN}✔ Successfully pushed {len(records)} account(s) to team vault!{NC}")
        for r in records:
            print(f"  • {r['email']}")
    except RuntimeError as e:
        if str(e) == 'table_not_found':
            print_supabase_sql_snippet()
        else:
            print(f"{RED}Database Push Error:{NC} {e}")

def cli_db_pull(vault_dir):
    config = get_db_config(vault_dir)
    if not config:
        print(f"{RED}Error:{NC} No database connected. Run '{BOLD}ag-auth db setup{NC}' first.")
        sys.exit(1)
    passphrase = config.get('passphrase')
    if not passphrase:
        print(f"{RED}Error:{NC} No encryption passphrase configured in db_config.json.")
        sys.exit(1)

    print(f"{CYAN}Pulling team accounts from remote database ({config.get('provider')})...{NC}")
    try:
        rows = db_api_fetch(config)
    except RuntimeError as e:
        if str(e) == 'table_not_found':
            print_supabase_sql_snippet()
            return
        else:
            print(f"{RED}Database Pull Error:{NC} {e}")
            return

    if not rows:
        print(f"{YELLOW}No remote profiles found in database.{NC}")
        return

    profiles_dir = os.path.join(vault_dir, 'profiles')
    os.makedirs(profiles_dir, exist_ok=True)
    pulled = 0

    for r in rows:
        email = r.get('email')
        enc_payload = r.get('enc_payload')
        if not email or not enc_payload:
            continue
        try:
            dec_json = decrypt_str(enc_payload, passphrase)
            data = json.loads(dec_json)
        except Exception:
            print(f"  {RED}✖ Failed to decrypt {email}{NC} (incorrect team passphrase!)")
            continue

        target_dir = os.path.join(profiles_dir, email)
        os.makedirs(target_dir, exist_ok=True)
        try:
            if sys.platform != 'win32': os.chmod(target_dir, 0o700)
        except Exception: pass

        for fn, content in data.get('files', {}).items():
            fp = os.path.join(target_dir, fn)
            with open(fp, 'w') as f:
                f.write(content)
            try:
                if sys.platform != 'win32': os.chmod(fp, 0o600)
            except Exception: pass

        pulled += 1
        synced_by = r.get('updated_by', 'remote')
        print(f"  {GREEN}✔ Synced:{NC} {BOLD}{email}{NC} {DIM}(updated by {synced_by}){NC}")

    print(f"\n{GREEN}✔ Decrypted and installed {pulled} team account(s) into your local vault!{NC}")

def cli_db_sync(vault_dir):
    print(f"{BOLD}{CYAN}=== Synchronizing Local & Team Vault ==={NC}")
    print(f"\n{BOLD}1. Pushing Local Profiles:{NC}")
    cli_db_push(vault_dir)
    print(f"\n{BOLD}2. Pulling Team Profiles:{NC}")
    cli_db_pull(vault_dir)
    print(f"\n{GREEN}✔ Synchronization complete!{NC}")

def cli_db_disconnect(vault_dir):
    cfg_path = os.path.join(vault_dir, 'db_config.json')
    if os.path.exists(cfg_path):
        os.remove(cfg_path)
        print(f"{GREEN}✔ Remote database unlinked successfully.{NC}")
        print("Your local vaulted profiles remain safe and intact.")
    else:
        print(f"{YELLOW}No remote database was connected.{NC}")

# --- Cross-Platform Keyring Helpers ---
def keyring_read():
    if sys.platform == 'darwin':
        try:
            import base64
            out = subprocess.check_output(['security', 'find-generic-password', '-s', 'gemini', '-a', 'antigravity', '-w'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
            if out.startswith('go-keyring-base64:'):
                b64_part = out[len('go-keyring-base64:'):]
                return base64.b64decode(b64_part).decode('utf-8')
            return out
        except Exception:
            return ''
    elif sys.platform.startswith('linux'):
        if shutil.which('secret-tool'):
            try:
                import base64
                out = subprocess.check_output(['secret-tool', 'lookup', 'service', 'gemini', 'account', 'antigravity'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
                if out.startswith('go-keyring-base64:'):
                    return base64.b64decode(out[len('go-keyring-base64:'):]).decode('utf-8')
                return out
            except Exception:
                return ''
    elif sys.platform in ('win32', 'cygwin'):
        try:
            cmd = "powershell -NoProfile -NonInteractive -Command \"[Windows.Security.Credentials.PasswordVault,Windows.Security.Credentials,ContentType=WindowsRuntime] | Out-Null; $v = New-Object Windows.Security.Credentials.PasswordVault; try { $c = $v.Retrieve('gemini', 'antigravity'); $c.RetrievePassword(); $c.Password } catch { '' }\""
            out = subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL).decode('utf-8').strip()
            if out.startswith('go-keyring-base64:'):
                import base64
                return base64.b64decode(out[len('go-keyring-base64:'):]).decode('utf-8')
            return out
        except Exception:
            return ''
    return ''

def keyring_sync(token_file):
    if not os.path.exists(token_file):
        return
    try:
        import base64
        with open(token_file, 'rb') as f:
            content = f.read()
        b64_val = 'go-keyring-base64:' + base64.b64encode(content).decode('utf-8')

        if sys.platform == 'darwin':
            subprocess.run(['security', 'add-generic-password', '-U', '-s', 'gemini', '-a', 'antigravity', '-w', b64_val], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif sys.platform.startswith('linux') and shutil.which('secret-tool'):
            subprocess.run(['secret-tool', 'store', '--label=Antigravity', 'service', 'gemini', 'account', 'antigravity'], input=b64_val.encode('utf-8'), check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif sys.platform in ('win32', 'cygwin'):
            cmd = f"powershell -NoProfile -NonInteractive -Command \"[Windows.Security.Credentials.PasswordVault,Windows.Security.Credentials,ContentType=WindowsRuntime] | Out-Null; $v = New-Object Windows.Security.Credentials.PasswordVault; $c = New-Object Windows.Security.Credentials.PasswordCredential('gemini', 'antigravity', '{b64_val}'); $v.Add($c)\""
            subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def keyring_delete():
    if sys.platform == 'darwin':
        subprocess.run(['security', 'delete-generic-password', '-s', 'gemini', '-a', 'antigravity'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif sys.platform.startswith('linux') and shutil.which('secret-tool'):
        subprocess.run(['secret-tool', 'clear', 'service', 'gemini', 'account', 'antigravity'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif sys.platform in ('win32', 'cygwin'):
        cmd = "powershell -NoProfile -NonInteractive -Command \"[Windows.Security.Credentials.PasswordVault,Windows.Security.Credentials,ContentType=WindowsRuntime] | Out-Null; $v = New-Object Windows.Security.Credentials.PasswordVault; try { $c = $v.Retrieve('gemini', 'antigravity'); $v.Remove($c) } catch {}\""
        subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

# --- SQLite IDE / App State Helpers ---
def sqlite_read_surface_state(db_path):
    if not os.path.exists(db_path):
        return None
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        cur.execute("SELECT key, value FROM ItemTable WHERE key IN ('antigravityUnifiedStateSync.oauthToken', 'antigravityUnifiedStateSync.userStatus', 'antigravityAuthStatus')")
        rows = dict(cur.fetchall())
        conn.close()
        return rows
    except Exception:
        return None

def sqlite_write_surface_state(db_path, state_dict):
    if not os.path.exists(db_path) or not state_dict:
        return False
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        for k, v in state_dict.items():
            if v is not None:
                cur.execute("INSERT OR REPLACE INTO ItemTable (key, value) VALUES (?, ?)", (k, v))
            else:
                cur.execute("DELETE FROM ItemTable WHERE key = ?", (k,))
        conn.commit()
        conn.close()
        return True
    except Exception:
        return False

def is_proc_active(proc_pattern):
    try:
        if sys.platform == 'win32':
            out = subprocess.check_output(['tasklist'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
            return proc_pattern.lower() in out.lower()
        else:
            out = subprocess.check_output(['pgrep', '-f', proc_pattern], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
            return bool(out.strip())
    except Exception:
        return False

# --- Formatting & Quotas ---
def color_pct(pct):
    if pct is None:
        return f'{DIM}N/A{NC}'
    if pct >= 50:
        return f'{GREEN}{pct:5.1f}%{NC}'
    elif pct >= 20:
        return f'{YELLOW}{pct:5.1f}%{NC}'
    else:
        return f'{RED}{pct:5.1f}%{NC}'

def render_bar(pct, width=10):
    if pct is None:
        return f'{DIM}[{"░" * width}]{NC}'
    filled = int(round((pct / 100.0) * width))
    filled = max(0, min(width, filled))
    empty = width - filled
    bar = '█' * filled + '░' * empty
    if pct >= 50:
        return f'{GREEN}[{bar}]{NC}'
    elif pct >= 20:
        return f'{YELLOW}[{bar}]{NC}'
    else:
        return f'{RED}[{bar}]{NC}'

def format_relative_time(target_iso):
    if not target_iso:
        return 'unknown'
    try:
        clean = target_iso.replace('Z', '+00:00')
        target_dt = datetime.datetime.fromisoformat(clean)
        now = datetime.datetime.now(datetime.timezone.utc)
        diff = target_dt - now
        secs = int(diff.total_seconds())
        if secs <= 0:
            return 'now'
        days = secs // 86400
        hours = (secs % 86400) // 3600
        mins = (secs % 3600) // 60
        if days > 0:
            return f'{days}d {hours}h'
        if hours > 0:
            return f'{hours}h {mins}m'
        return f'{mins}m'
    except Exception:
        return target_iso

def refresh_token(refresh_tok):
    data = {
        'client_id': CLIENT_ID,
        'client_secret': CLIENT_SECRET,
        'refresh_token': refresh_tok,
        'grant_type': 'refresh_token',
    }
    req = urllib.request.Request(
        TOKEN_URL,
        data=urllib.parse.urlencode(data).encode('utf-8'),
        headers={'Content-Type': 'application/x-www-form-urlencoded'}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode('utf-8'))

def get_profile_quota(profile_path, force=False):
    cache_path = os.path.join(profile_path, 'quota_cache.json')
    if not force and os.path.exists(cache_path):
        try:
            with open(cache_path) as f:
                c = json.load(f)
            if time.time() - c.get('fetched_at', 0) < CACHE_TTL:
                return c.get('data')
        except Exception:
            pass

    token_path = os.path.join(profile_path, 'antigravity-oauth-token')
    if not os.path.exists(token_path):
        return {'error': 'No token file found'}

    try:
        with open(token_path) as f:
            tok_data = json.load(f)
    except Exception as e:
        return {'error': f'Failed to read token: {e}'}

    tok_obj = tok_data.get('token', {})
    access_token = tok_obj.get('access_token')
    refresh_tok = tok_obj.get('refresh_token')
    expiry = tok_obj.get('expiry')

    is_expired = False
    if expiry:
        try:
            exp_clean = expiry.replace('Z', '+00:00')
            exp_dt = datetime.datetime.fromisoformat(exp_clean)
            now = datetime.datetime.now(exp_dt.tzinfo)
            if (exp_dt - now).total_seconds() < 60:
                is_expired = True
        except Exception:
            is_expired = True
    else:
        is_expired = True

    if is_expired and refresh_tok:
        try:
            ref = refresh_token(refresh_tok)
            access_token = ref.get('access_token')
            tok_obj['access_token'] = access_token
            if 'id_token' in ref:
                tok_data['id_token'] = ref['id_token']
            if 'expires_in' in ref:
                new_exp = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=ref['expires_in'])
                tok_obj['expiry'] = new_exp.isoformat()
            tok_data['token'] = tok_obj
            with open(token_path, 'w') as f:
                json.dump(tok_data, f, indent=2)
            try:
                os.chmod(token_path, 0o600)
            except Exception:
                pass
        except Exception as e:
            return {'error': f'Token refresh failed: {e}'}

    if not access_token:
        return {'error': 'No access token available'}

    qreq = urllib.request.Request(
        QUOTA_URL,
        data=b'{}',
        headers={
            'Authorization': f'Bearer {access_token}',
            'Content-Type': 'application/json',
            'User-Agent': 'antigravity-cli'
        }
    )
    try:
        with urllib.request.urlopen(qreq, timeout=10) as qresp:
            qdata = json.loads(qresp.read().decode('utf-8'))
    except Exception as e:
        return {'error': f'Quota request failed: {e}'}

    parsed = {
        'gemini': {},
        'claude': {}
    }
    for g in qdata.get('groups', []):
        gname = g.get('displayName', '').lower()
        target_group = 'gemini' if 'gemini' in gname else 'claude'
        for b in g.get('buckets', []):
            window = b.get('window', '')
            frac = b.get('remainingFraction', 0.0)
            reset_time = b.get('resetTime', '')
            parsed[target_group][window] = {
                'fraction': frac,
                'pct': round(frac * 100, 1),
                'reset_time': reset_time,
                'resets_in': format_relative_time(reset_time),
                'desc': b.get('description', '')
            }

    try:
        with open(cache_path, 'w') as f:
            json.dump({'fetched_at': time.time(), 'data': parsed}, f)
        try:
            os.chmod(cache_path, 0o600)
        except Exception:
            pass
    except Exception:
        pass

    return parsed

def get_vault_profiles(vault_dir):
    profiles = []
    if os.path.exists(vault_dir):
        for d in sorted(os.listdir(vault_dir)):
            p = os.path.join(vault_dir, d)
            token_path = os.path.join(p, 'antigravity-oauth-token')
            if os.path.isdir(p) and os.path.exists(token_path):
                profiles.append(d)
    return profiles

# --- CLI Actions ---
def cli_list(vault_dir, active_email, force=False):
    profiles = get_vault_profiles(vault_dir)
    if not profiles:
        print(f"{YELLOW}No profiles found in vault ({vault_dir}).{NC}")
        print(f"Run '{BOLD}ag-auth save{NC}' to archive the current active session.")
        return

    print(f"{BOLD}{BLUE}=== Vaulted Antigravity Profiles & Quotas ==={NC}\n")

    def fetch_p(pname):
        pdir = os.path.join(vault_dir, pname)
        q = get_profile_quota(pdir, force=force)
        exp_str = ''
        surfaces = ['CLI']
        if os.path.exists(os.path.join(pdir, 'ide_state.json')):
            surfaces.append('IDE')
        if os.path.exists(os.path.join(pdir, 'app_state.json')):
            surfaces.append('App')

        try:
            with open(os.path.join(pdir, 'antigravity-oauth-token')) as f:
                tdata = json.load(f)
            tok = tdata.get('id_token', '')
            if tok:
                import base64
                claims = json.loads(base64.urlsafe_b64decode(tok.split('.')[1] + '==='))
                if claims.get('exp'):
                    dt = datetime.datetime.fromtimestamp(claims['exp'], datetime.timezone.utc)
                    exp_str = dt.strftime('%Y-%m-%d %H:%M:%S UTC')
        except Exception:
            pass
        return pname, q, exp_str, ', '.join(surfaces)

    with ThreadPoolExecutor(max_workers=5) as ex:
        results = list(ex.map(fetch_p, profiles))

    for pname, q, exp_str, surf_str in results:
        is_active = (pname == active_email)
        prefix = f"{GREEN}▶ {BOLD}{pname}{NC} {GREEN}[CURRENT ACTIVE]{NC} {DIM}({surf_str}){NC}" if is_active else f"    {BOLD}{pname}{NC} {DIM}({surf_str}){NC}"
        print(prefix)

        if 'error' in q:
            print(f"      {DIM}Quota: {q['error']}{NC}")
        elif 'gemini' in q:
            gw = q['gemini'].get('weekly', {})
            g5 = q['gemini'].get('5h', {})
            cw = q['claude'].get('weekly', {})
            c5 = q['claude'].get('5h', {})

            gw_bar = render_bar(gw.get('pct'))
            gw_pct = color_pct(gw.get('pct'))
            g5_pct = color_pct(g5.get('pct'))
            gw_reset = f" {DIM}(resets: {gw.get('resets_in')}){NC}" if (gw.get('resets_in') and gw.get('resets_in') != 'now' and gw.get('pct', 100) < 100) else ""
            print(f"      Gemini:  {gw_bar} {gw_pct} weekly{gw_reset} | {g5_pct} 5h")

            cw_bar = render_bar(cw.get('pct'))
            cw_pct = color_pct(cw.get('pct'))
            c5_pct = color_pct(c5.get('pct'))
            cw_reset = f" {DIM}(resets: {cw.get('resets_in')}){NC}" if (cw.get('resets_in') and cw.get('resets_in') != 'now' and cw.get('pct', 100) < 100) else ""
            print(f"      Claude:  {cw_bar} {cw_pct} weekly{cw_reset} | {c5_pct} 5h")

        if exp_str:
            print(f"      {DIM}Token Expiry: {exp_str}{NC}")
        print()

def cli_quota(vault_dir, active_email, target_profile=None, force=False):
    profiles = get_vault_profiles(vault_dir)
    if target_profile:
        if target_profile not in profiles:
            print(f"{RED}Error:{NC} Profile '{target_profile}' not found in vault.")
            sys.exit(1)
        profiles = [target_profile]

    if not profiles:
        print(f"{YELLOW}No profiles found in vault ({vault_dir}).{NC}")
        return

    print(f"{BOLD}{MAGENTA}========================================{NC}")
    print(f"{BOLD}{MAGENTA}  Universal Antigravity Quota Dashboard {NC}")
    print(f"{BOLD}{MAGENTA}========================================{NC}\n")

    def fetch_p(pname):
        pdir = os.path.join(vault_dir, pname)
        return pname, get_profile_quota(pdir, force=force)

    with ThreadPoolExecutor(max_workers=5) as ex:
        results = list(ex.map(fetch_p, profiles))

    for pname, q in results:
        is_active = (pname == active_email)
        tag = f" {GREEN}[CURRENT ACTIVE]{NC}" if is_active else ""
        print(f"{BOLD}{CYAN}Account: {pname}{NC}{tag}")

        if 'error' in q:
            print(f"  {RED}Quota Error:{NC} {q['error']}\n")
            continue

        gem = q.get('gemini', {})
        gw = gem.get('weekly', {})
        g5 = gem.get('5h', {})

        print(f"  {BOLD}• Gemini Models (Flash, Pro):{NC}")
        gw_bar = render_bar(gw.get('pct'), width=12)
        gw_pct = color_pct(gw.get('pct'))
        gw_res = f" {DIM}(resets in {gw.get('resets_in')}){NC}" if gw.get('resets_in') and gw.get('pct', 100) < 100 else ""
        print(f"      Weekly Limit:  {gw_bar} {gw_pct}{gw_res}")

        g5_bar = render_bar(g5.get('pct'), width=12)
        g5_pct = color_pct(g5.get('pct'))
        g5_res = f" {DIM}(resets in {g5.get('resets_in')}){NC}" if g5.get('resets_in') and g5.get('pct', 100) < 100 else ""
        print(f"      5-Hour Window: {g5_bar} {g5_pct}{g5_res}")

        cld = q.get('claude', {})
        cw = cld.get('weekly', {})
        c5 = cld.get('5h', {})

        print(f"  {BOLD}• Claude & GPT Models (Sonnet, Opus, GPT-OSS):{NC}")
        cw_bar = render_bar(cw.get('pct'), width=12)
        cw_pct = color_pct(cw.get('pct'))
        cw_res = f" {DIM}(resets in {cw.get('resets_in')}){NC}" if cw.get('resets_in') and cw.get('pct', 100) < 100 else ""
        print(f"      Weekly Limit:  {cw_bar} {cw_pct}{cw_res}")

        c5_bar = render_bar(c5.get('pct'), width=12)
        c5_pct = color_pct(c5.get('pct'))
        c5_res = f" {DIM}(resets in {c5.get('resets_in')}){NC}" if c5.get('resets_in') and c5.get('pct', 100) < 100 else ""
        print(f"      5-Hour Window: {c5_bar} {c5_pct}{c5_res}\n")

def cli_current_quota(vault_dir, active_email):
    if not active_email:
        return
    pdir = os.path.join(vault_dir, active_email)
    if not os.path.exists(pdir):
        return
    q = get_profile_quota(pdir, force=False)
    if not q or 'error' in q:
        return

    print(f"\n{BOLD}AI Quota Limits:{NC}")
    gw = q.get('gemini', {}).get('weekly', {})
    g5 = q.get('gemini', {}).get('5h', {})
    cw = q.get('claude', {}).get('weekly', {})
    c5 = q.get('claude', {}).get('5h', {})

    gw_bar = render_bar(gw.get('pct'))
    gw_pct = color_pct(gw.get('pct'))
    gw_res = f" {DIM}(resets: {gw.get('resets_in')}){NC}" if (gw.get('resets_in') and gw.get('pct', 100) < 100) else ""
    g5_pct = color_pct(g5.get('pct'))
    print(f"  Gemini: {gw_bar} {gw_pct} weekly{gw_res} | {g5_pct} 5h")

    cw_bar = render_bar(cw.get('pct'))
    cw_pct = color_pct(cw.get('pct'))
    cw_res = f" {DIM}(resets: {cw.get('resets_in')}){NC}" if (cw.get('resets_in') and cw.get('pct', 100) < 100) else ""
    c5_pct = color_pct(c5.get('pct'))
    print(f"  Claude: {cw_bar} {cw_pct} weekly{cw_res} | {c5_pct} 5h")

# --- Cross-Platform Keystroke Reader ---
def read_single_key():
    if sys.platform in ('win32', 'cygwin'):
        import msvcrt
        ch = msvcrt.getch()
        if ch in (b'\x00', b'\xe0'):
            ch2 = msvcrt.getch()
            if ch2 == b'H': return 'UP'
            elif ch2 == b'P': return 'DOWN'
            return ''
        elif ch in (b'\r', b'\n'):
            return 'ENTER'
        elif ch in (b'\x03', b'q', b'Q'):
            return 'CANCEL'
        try:
            return ch.decode('utf-8', errors='ignore')
        except Exception:
            return ''
    else:
        import termios, tty
        tty_fd = os.open('/dev/tty', os.O_RDONLY)
        old_settings = termios.tcgetattr(tty_fd)
        try:
            tty.setraw(tty_fd)
            ch = os.read(tty_fd, 1).decode('utf-8', errors='ignore')
            if ch == '\x1b':
                seq = os.read(tty_fd, 2).decode('utf-8', errors='ignore')
                if seq == '[A': return 'UP'
                elif seq == '[B': return 'DOWN'
                return ''
            elif ch in ('\r', '\n'):
                return 'ENTER'
            elif ch in ('\x03', 'q', 'Q'):
                return 'CANCEL'
            return ch
        finally:
            termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_settings)
            os.close(tty_fd)

def cli_pick_interactive(vault_dir, active_email):
    profiles = get_vault_profiles(vault_dir)
    if not profiles:
        sys.stderr.write(f"{YELLOW}No saved profiles found in vault.{NC}\n")
        sys.exit(1)

    def fetch_p(pname):
        pdir = os.path.join(vault_dir, pname)
        q = get_profile_quota(pdir, force=False)
        tag = ''
        if q and 'gemini' in q:
            gp = q['gemini'].get('weekly', {}).get('pct')
            cp = q['claude'].get('weekly', {}).get('pct')
            parts = []
            if gp is not None:
                parts.append(f"Gem: {color_pct(gp)}")
            if cp is not None:
                parts.append(f"Cld: {color_pct(cp)}")
            if parts:
                tag = f"[{' | '.join(parts)}]"
        return pname, tag

    with ThreadPoolExecutor(max_workers=5) as ex:
        items = list(ex.map(fetch_p, profiles))

    if sys.platform != 'win32':
        try:
            tfd = os.open('/dev/tty', os.O_RDONLY)
            if not os.isatty(tfd): raise OSError()
            os.close(tfd)
        except Exception:
            sys.stdout.write(items[0][0])
            sys.exit(0)

    selected = 0
    for idx, (name, _) in enumerate(items):
        if name != active_email:
            selected = idx
            break

    sys.stderr.write('\033[?25l')  # Hide cursor
    try:
        while True:
            out = ['\r\033[K\033[1;36mSelect Universal Antigravity Account (\u2191/\u2193 arrow keys, Enter to switch, q to cancel):\033[0m\n\r']
            for i, (name, tag) in enumerate(items):
                is_active = f' {GREEN}[CURRENT ACTIVE]{NC}' if name == active_email else ''
                tag_str = f'  {tag}' if tag else ''
                if i == selected:
                    out.append(f'\r\033[K  {GREEN}{BOLD}\u25b6 [{i+1}] {name}{NC}{tag_str}{is_active}\n\r')
                else:
                    out.append(f'\r\033[K    [{i+1}] {name}{tag_str}{is_active}\n\r')
            sys.stderr.write(''.join(out))
            sys.stderr.write(f'\033[{len(items) + 1}A')
            sys.stderr.flush()

            key = read_single_key()
            if key == 'UP':
                selected = (selected - 1) % len(items)
            elif key == 'DOWN':
                selected = (selected + 1) % len(items)
            elif key.isdigit() and 1 <= int(key) <= len(items):
                selected = int(key) - 1
                sys.stderr.write(f'\033[{len(items) + 1}B\r\n')
                sys.stderr.flush()
                sys.stdout.write(items[selected][0])
                sys.exit(0)
            elif key == 'ENTER':
                sys.stderr.write(f'\033[{len(items) + 1}B\r\n')
                sys.stderr.flush()
                sys.stdout.write(items[selected][0])
                sys.exit(0)
            elif key == 'CANCEL':
                sys.stderr.write(f'\033[{len(items) + 1}B\r\n\033[1;33mCancelled.\033[0m\n\r')
                sys.stderr.flush()
                sys.exit(1)
    finally:
        sys.stderr.write('\033[?25h')  # Restore cursor
        sys.stderr.flush()

# --- Dispatcher ---
if __name__ == '__main__':
    action = sys.argv[1] if len(sys.argv) > 1 else 'list'
    v_dir = os.path.expanduser(sys.argv[2]) if len(sys.argv) > 2 else ''
    act_email = sys.argv[3] if len(sys.argv) > 3 else ''

    if action == 'list':
        force_flag = (len(sys.argv) > 4 and sys.argv[4] == 'true')
        cli_list(v_dir, act_email, force=force_flag)
    elif action == 'quota':
        target = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] != '' else None
        force_flag = (len(sys.argv) > 5 and sys.argv[5] == 'true')
        cli_quota(v_dir, act_email, target_profile=target, force=force_flag)
    elif action == 'current_quota':
        cli_current_quota(v_dir, act_email)
    elif action == 'pick':
        cli_pick_interactive(v_dir, act_email)
    elif action == 'keyring_read':
        tok = keyring_read()
        if tok: sys.stdout.write(tok)
    elif action == 'keyring_sync':
        token_f = sys.argv[2] if len(sys.argv) > 2 else ''
        keyring_sync(token_f)
    elif action == 'keyring_delete':
        keyring_delete()
    elif action == 'surface_save':
        pdir = os.path.expanduser(sys.argv[2])
        ide_db = os.path.expanduser(sys.argv[3]) if len(sys.argv) > 3 else ''
        app_db = os.path.expanduser(sys.argv[4]) if len(sys.argv) > 4 else ''
        if ide_db and os.path.exists(ide_db):
            s = sqlite_read_surface_state(ide_db)
            if s:
                with open(os.path.join(pdir, 'ide_state.json'), 'w') as f:
                    json.dump(s, f, indent=2)
        if app_db and os.path.exists(app_db):
            s = sqlite_read_surface_state(app_db)
            if s:
                with open(os.path.join(pdir, 'app_state.json'), 'w') as f:
                    json.dump(s, f, indent=2)
    elif action == 'surface_restore':
        pdir = os.path.expanduser(sys.argv[2])
        ide_db = os.path.expanduser(sys.argv[3]) if len(sys.argv) > 3 else ''
        app_db = os.path.expanduser(sys.argv[4]) if len(sys.argv) > 4 else ''
        choice = sys.argv[5] if len(sys.argv) > 5 else 'all'

        if choice in ('all', 'ide') and ide_db and os.path.exists(ide_db):
            fpath = os.path.join(pdir, 'ide_state.json')
            if os.path.exists(fpath):
                try:
                    with open(fpath) as f:
                        data = json.load(f)
                    sqlite_write_surface_state(ide_db, data)
                except Exception:
                    pass
            if is_proc_active('Antigravity IDE'):
                print(f"  {YELLOW}ℹ Antigravity IDE is running. Reload window (Cmd/Ctrl+Shift+P -> 'Reload Window') to apply session.{NC}")

        if choice in ('all', 'app') and app_db and os.path.exists(app_db):
            fpath = os.path.join(pdir, 'app_state.json')
            if os.path.exists(fpath):
                try:
                    with open(fpath) as f:
                        data = json.load(f)
                    sqlite_write_surface_state(app_db, data)
                except Exception:
                    pass
            if is_proc_active('Antigravity'):
                print(f"  {YELLOW}ℹ Antigravity 2.0 Desktop App is running. Restart app to apply session.{NC}")
    elif action == 'surface_clear':
        ide_db = os.path.expanduser(sys.argv[2]) if len(sys.argv) > 2 else ''
        app_db = os.path.expanduser(sys.argv[3]) if len(sys.argv) > 3 else ''
        choice = sys.argv[4] if len(sys.argv) > 4 else 'all'
        empty_state = {
            'antigravityUnifiedStateSync.oauthToken': '',
            'antigravityUnifiedStateSync.userStatus': '',
            'antigravityAuthStatus': None
        }
        if choice in ('all', 'ide') and ide_db and os.path.exists(ide_db):
            sqlite_write_surface_state(ide_db, empty_state)
        if choice in ('all', 'app') and app_db and os.path.exists(app_db):
            sqlite_write_surface_state(app_db, empty_state)
    elif action == 'db_setup':
        cli_db_setup(v_dir)
    elif action == 'db_status':
        cli_db_status(v_dir)
    elif action == 'db_push':
        cli_db_push(v_dir)
    elif action == 'db_pull':
        cli_db_pull(v_dir)
    elif action == 'db_sync':
        cli_db_sync(v_dir)
    elif action == 'db_disconnect':
        cli_db_disconnect(v_dir)
PYEOF
}

# ------------------------------------------------------------------------------
# 3. Keyring Wrappers (Delegated to Universal Python Engine)
# ------------------------------------------------------------------------------
keychain_read_token() {
    run_vault_python "keyring_read" "" ""
}

keychain_sync_token() {
    local token_file="$1"
    run_vault_python "keyring_sync" "${token_file}" ""
}

keychain_delete_token() {
    run_vault_python "keyring_delete" "" ""
}

# ------------------------------------------------------------------------------
# 4. Identity & Token Parsers
# ------------------------------------------------------------------------------
get_token_email() {
    local token_file="${1:-}"
    python3 -c "
import json, base64, sys, subprocess

raw_json = ''
if '${token_file}' and '${token_file}' != 'keychain':
    try:
        with open('${token_file}', 'r') as f:
            raw_json = f.read()
    except Exception:
        pass
else:
    raw_json = subprocess.check_output(['python3', '-c', '''
import sys, subprocess, shutil, base64
if sys.platform == \"darwin\":
    try:
        out = subprocess.check_output(['security', 'find-generic-password', '-s', 'gemini', '-a', 'antigravity', '-w'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
        if out.startswith('go-keyring-base64:'): print(base64.b64decode(out[18:]).decode('utf-8'))
        else: print(out)
    except: pass
elif sys.platform.startswith(\"linux\") and shutil.which(\"secret-tool\"):
    try:
        out = subprocess.check_output(['secret-tool', 'lookup', 'service', 'gemini', 'account', 'antigravity'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
        if out.startswith('go-keyring-base64:'): print(base64.b64decode(out[18:]).decode('utf-8'))
        else: print(out)
    except: pass
'''], stderr=subprocess.DEVNULL).decode('utf-8').strip()

if not raw_json:
    print('')
    sys.exit(0)

try:
    data = json.loads(raw_json)
    id_token = data.get('id_token', '')
    if not id_token:
        print('')
        sys.exit(0)
    payload = id_token.split('.')[1]
    padded = payload + '=' * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode(padded))
    print(claims.get('email', ''))
except Exception:
    print('')
" 2>/dev/null
}

get_token_exp() {
    local token_file="${1:-}"
    python3 -c "
import json, base64, sys, datetime, subprocess

raw_json = ''
if '${token_file}' and '${token_file}' != 'keychain':
    try:
        with open('${token_file}', 'r') as f:
            raw_json = f.read()
    except Exception:
        pass
else:
    raw_json = subprocess.check_output(['python3', '-c', '''
import sys, subprocess, shutil, base64
if sys.platform == \"darwin\":
    try:
        out = subprocess.check_output(['security', 'find-generic-password', '-s', 'gemini', '-a', 'antigravity', '-w'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
        if out.startswith('go-keyring-base64:'): print(base64.b64decode(out[18:]).decode('utf-8'))
        else: print(out)
    except: pass
elif sys.platform.startswith(\"linux\") and shutil.which(\"secret-tool\"):
    try:
        out = subprocess.check_output(['secret-tool', 'lookup', 'service', 'gemini', 'account', 'antigravity'], stderr=subprocess.DEVNULL).decode('utf-8').strip()
        if out.startswith('go-keyring-base64:'): print(base64.b64decode(out[18:]).decode('utf-8'))
        else: print(out)
    except: pass
'''], stderr=subprocess.DEVNULL).decode('utf-8').strip()

if not raw_json:
    print('')
    sys.exit(0)

try:
    data = json.loads(raw_json)
    id_token = data.get('id_token', '')
    if not id_token:
        print('')
        sys.exit(0)
    payload = id_token.split('.')[1]
    padded = payload + '=' * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode(padded))
    exp = claims.get('exp')
    if exp:
        dt = datetime.datetime.fromtimestamp(exp, datetime.timezone.utc)
        print(dt.strftime('%Y-%m-%d %H:%M:%S UTC'))
    else:
        print('unknown')
except Exception:
    print('')
" 2>/dev/null
}

pick_profile_interactive() {
    local active_email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        active_email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        active_email=$(get_token_email "keychain")
    fi

    run_vault_python "pick" "${PROFILES_DIR}" "${active_email}"
}

# ------------------------------------------------------------------------------
# 5. Core Vault Commands
# ------------------------------------------------------------------------------
cmd_current() {
    echo -e "${BOLD}${CYAN}=== Universal Antigravity Active Session ===${NC}"
    echo -e "Platform:       ${BOLD}${PLATFORM}${NC}"
    
    local email="" exp="" src=""

    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        email=$(get_token_email "${ACTIVE_TOKEN}")
        exp=$(get_token_exp "${ACTIVE_TOKEN}")
        src="File (${ACTIVE_TOKEN})"
    else
        email=$(get_token_email "keychain")
        if [[ -n "${email}" ]]; then
            exp=$(get_token_exp "keychain")
            src="OS Keyring (service: gemini, account: antigravity)"
        fi
    fi

    if [[ -z "${email}" ]]; then
        echo -e "${YELLOW}Status:${NC} Detached / No active session found."
        echo -e "Ready for fresh login via Antigravity CLI, IDE, or 2.0 Desktop."
        return 0
    fi

    echo -e "${GREEN}Active Account:${NC} ${BOLD}${email}${NC}"
    [[ -n "${exp}" ]] && echo -e "Token Expiry:   ${exp}"
    echo -e "Storage Source: ${src}"

    # Surface statuses
    echo -e "\n${BOLD}Runtime Surfaces:${NC}"
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        echo -e "  • ${GREEN}✔ CLI:${NC} Active in ${ACTIVE_TOKEN}"
    else
        echo -e "  • ${YELLOW}○ CLI:${NC} Detached"
    fi

    if [[ -f "${IDE_STORAGE}" ]]; then
        echo -e "  • ${GREEN}✔ IDE:${NC} Storage connected (${IDE_STORAGE})"
    else
        echo -e "  • ${DIM}○ IDE:${NC} Not installed or default DB not found"
    fi

    if [[ -f "${APP_STORAGE}" ]]; then
        echo -e "  • ${GREEN}✔ 2.0 Desktop:${NC} Storage connected (${APP_STORAGE})"
    else
        echo -e "  • ${DIM}○ 2.0 Desktop:${NC} Not installed or default DB not found"
    fi

    run_vault_python "current_quota" "${PROFILES_DIR}" "${email}"
}

cmd_save() {
    ensure_vault_dirs
    local target_name="${1:-}"

    local email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        email=$(get_token_email "keychain")
    fi

    if [[ -z "${email}" && ! -f "${ACTIVE_TOKEN}" ]]; then
        echo -e "${RED}Error:${NC} No active token found in filesystem or OS Keyring to save."
        exit 1
    fi

    if [[ -z "${target_name}" ]]; then
        if [[ -n "${email}" ]]; then
            target_name="${email}"
        else
            echo -e "${RED}Error:${NC} Could not auto-detect email claim."
            echo -e "Please supply a profile name: ${BOLD}ag-auth save <profile_name>${NC}"
            exit 1
        fi
    fi

    local profile_path="${PROFILES_DIR}/${target_name}"
    mkdir -p "${profile_path}"
    if [[ "${PLATFORM}" != "windows" ]]; then
        chmod 700 "${profile_path}" 2>/dev/null || true
    fi

    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        cp "${ACTIVE_TOKEN}" "${profile_path}/antigravity-oauth-token"
    else
        keychain_read_token > "${profile_path}/antigravity-oauth-token"
    fi
    if [[ "${PLATFORM}" != "windows" ]]; then
        chmod 600 "${profile_path}/antigravity-oauth-token" 2>/dev/null || true
    fi

    if [[ -f "${ACTIVE_CREDS}" ]]; then
        cp "${ACTIVE_CREDS}" "${profile_path}/oauth_creds.json"
        [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${profile_path}/oauth_creds.json" 2>/dev/null || true
    fi

    if [[ -f "${ACTIVE_ACCOUNTS}" ]]; then
        cp "${ACTIVE_ACCOUNTS}" "${profile_path}/google_accounts.json"
        [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${profile_path}/google_accounts.json" 2>/dev/null || true
    fi

    # Save Antigravity IDE and 2.0 App SQLite state snapshots
    run_vault_python "surface_save" "${profile_path}" "${IDE_STORAGE}" "${APP_STORAGE}"

    cat <<EOF > "${profile_path}/profile.json"
{
  "profile": "${target_name}",
  "email": "${email}",
  "platform": "${PLATFORM}",
  "saved_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
    [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${profile_path}/profile.json" 2>/dev/null || true

    echo -e "${GREEN}✔ Profile successfully saved to vault:${NC} ${BOLD}${target_name}${NC}"
    echo -e "  Vault location: ${profile_path}"
    local saved_surfaces="CLI"
    [[ -f "${profile_path}/ide_state.json" ]] && saved_surfaces="${saved_surfaces} + IDE"
    [[ -f "${profile_path}/app_state.json" ]] && saved_surfaces="${saved_surfaces} + 2.0 Desktop"
    echo -e "  Surfaces captured: ${GREEN}${saved_surfaces}${NC}"
}

cmd_list() {
    ensure_vault_dirs
    local refresh="${1:-false}"
    local active_email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        active_email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        active_email=$(get_token_email "keychain")
    fi

    run_vault_python "list" "${PROFILES_DIR}" "${active_email}" "${refresh}"
}

cmd_quota() {
    ensure_vault_dirs
    local target_profile="${1:-}"
    local refresh="${2:-false}"
    local active_email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        active_email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        active_email=$(get_token_email "keychain")
    fi

    run_vault_python "quota" "${PROFILES_DIR}" "${active_email}" "${target_profile}" "${refresh}"
}

cmd_detach() {
    ensure_vault_dirs
    local surface_choice="${1:-all}"
    echo -e "${YELLOW}Preparing to detach current session (surface: ${surface_choice})...${NC}"

    # Stop background remote-control daemon if running
    if command -v agy >/dev/null 2>&1; then
        agy remote-control stop >/dev/null 2>&1 || true
    fi

    local email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        email=$(get_token_email "keychain")
    fi

    if [[ -n "${email}" ]]; then
        local auto_name="${email}"
        echo -e "1. Auto-saving active session for '${BOLD}${auto_name}${NC}'..."
        cmd_save "${auto_name}" >/dev/null
    fi

    if [[ "${surface_choice}" == "all" || "${surface_choice}" == "cli" ]]; then
        echo -e "2. Removing CLI active token: ${ACTIVE_TOKEN}..."
        rm -f "${ACTIVE_TOKEN}"
        echo -e "3. Clearing OS Keyring entry (gemini/antigravity)..."
        keychain_delete_token
    fi

    # Clear IDE & App storage
    run_vault_python "surface_clear" "${IDE_STORAGE}" "${APP_STORAGE}" "${surface_choice}"

    echo -e "${GREEN}✔ Active session successfully detached!${NC}"
    echo -e "\n${BOLD}${CYAN}Next Steps to Authenticate New Account:${NC}"
    echo -e "  1. Run Antigravity CLI (${BOLD}agy${NC}), launch ${BOLD}Antigravity IDE${NC}, or open ${BOLD}Antigravity 2.0${NC}"
    echo -e "  2. Complete Google OAuth login in your browser."
    echo -e "  3. Once authenticated, run: ${BOLD}ag-auth save${NC}"
    echo -e "  4. Switch anytime using: ${BOLD}@${NC} or ${BOLD}ag-auth switch${NC}"
}

cmd_switch() {
    ensure_vault_dirs
    local target="${1:-}"
    local surface_choice="${2:-all}"

    # Interactive picker if no profile given
    if [[ -z "${target}" ]]; then
        target=$(pick_profile_interactive)
        if [[ -z "${target}" ]]; then
            exit 0
        fi
    fi

    local profile_path="${PROFILES_DIR}/${target}"

    if [[ ! -d "${profile_path}" || ! -f "${profile_path}/antigravity-oauth-token" ]]; then
        echo -e "${RED}Error:${NC} Profile '${target}' does not exist in vault."
        echo ""
        cmd_list
        exit 1
    fi

    # Auto-preserve active session first
    local current_email=""
    if [[ -f "${ACTIVE_TOKEN}" ]]; then
        current_email=$(get_token_email "${ACTIVE_TOKEN}")
    else
        current_email=$(get_token_email "keychain")
    fi

    if [[ -n "${current_email}" && "${current_email}" != "${target}" ]]; then
        cmd_save "${current_email}" >/dev/null 2>&1 || true
    fi

    # 1. Sync CLI token & OS Keyring
    if [[ "${surface_choice}" == "all" || "${surface_choice}" == "cli" ]]; then
        mkdir -p "${CLI_DIR}"
        local tmp_file="${CLI_DIR}/.antigravity-oauth-token.tmp.$$"
        cp "${profile_path}/antigravity-oauth-token" "${tmp_file}"
        [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${tmp_file}" 2>/dev/null || true
        mv "${tmp_file}" "${ACTIVE_TOKEN}"

        keychain_sync_token "${ACTIVE_TOKEN}"

        if [[ -f "${profile_path}/oauth_creds.json" ]]; then
            local tmp_creds="${GEMINI_DIR}/.oauth_creds.tmp.$$"
            cp "${profile_path}/oauth_creds.json" "${tmp_creds}"
            [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${tmp_creds}" 2>/dev/null || true
            mv "${tmp_creds}" "${ACTIVE_CREDS}"
        fi

        if [[ -f "${profile_path}/google_accounts.json" ]]; then
            local tmp_accs="${GEMINI_DIR}/.google_accounts.tmp.$$"
            cp "${profile_path}/google_accounts.json" "${tmp_accs}"
            [[ "${PLATFORM}" != "windows" ]] && chmod 600 "${tmp_accs}" 2>/dev/null || true
            mv "${tmp_accs}" "${ACTIVE_ACCOUNTS}"
        fi
    fi

    # 2. Sync IDE & App storage
    run_vault_python "surface_restore" "${profile_path}" "${IDE_STORAGE}" "${APP_STORAGE}" "${surface_choice}"

    echo -e "${GREEN}✔ Successfully switched session to:${NC} ${BOLD}${target}${NC} (surface: ${surface_choice})"
    echo ""
    cmd_current
}

cmd_delete() {
    ensure_vault_dirs
    local target="${1:-}"

    if [[ -z "${target}" ]]; then
        target=$(pick_profile_interactive)
        if [[ -z "${target}" ]]; then
            exit 0
        fi
    fi

    local profile_path="${PROFILES_DIR}/${target}"

    if [[ ! -d "${profile_path}" ]]; then
        echo -e "${RED}Error:${NC} Profile '${target}' not found."
        exit 1
    fi

    read -rp "Are you sure you want to permanently delete profile '${target}'? [y/N]: " confirm
    if [[ "${confirm}" =~ ^[Yy]$ ]]; then
        rm -rf "${profile_path}"
        echo -e "${GREEN}✔ Profile '${target}' removed from vault.${NC}"
    else
        echo "Canceled."
    fi
}

cmd_db() {
    ensure_vault_dirs
    local sub="${1:-status}"
    case "${sub}" in
        setup|configure)
            run_vault_python "db_setup" "${VAULT_DIR}" ""
            ;;
        status|info)
            run_vault_python "db_status" "${VAULT_DIR}" ""
            ;;
        push|upload)
            run_vault_python "db_push" "${VAULT_DIR}" ""
            ;;
        pull|download)
            run_vault_python "db_pull" "${VAULT_DIR}" ""
            ;;
        sync)
            run_vault_python "db_sync" "${VAULT_DIR}" ""
            ;;
        disconnect|unlink)
            run_vault_python "db_disconnect" "${VAULT_DIR}" ""
            ;;
        *)
            echo "Usage: ag-auth db [setup|status|push|pull|sync|disconnect]"
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 6. Tab Autocompletion Engine
# ------------------------------------------------------------------------------
cmd_profiles() {
    ensure_vault_dirs
    if [[ -d "${PROFILES_DIR}" ]]; then
        for d in "${PROFILES_DIR}"/*; do
            if [[ -d "$d" && -f "$d/antigravity-oauth-token" ]]; then
                basename "$d"
            fi
        done
    fi
}

cmd_completion() {
    local shell_type="${1:-}"
    case "${shell_type}" in
        bash)
            cat << 'EOF'
# Bash completion for ag-auth and @
_ag_auth_completions() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion -n : 2>/dev/null || { cur="${COMP_WORDS[COMP_CWORD]}"; prev="${COMP_WORDS[COMP_CWORD-1]}"; }
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi

    local commands="switch quota list current save detach delete db completion version help"
    local flags="--refresh -r --force -f --surface -s --help -h --version -v"
    local surfaces="all cli ide app"
    local db_cmds="setup status push pull sync disconnect"

    if [[ ${COMP_CWORD} -eq 1 ]]; then
        if [[ "$1" == "@" ]]; then
            local profiles=$(ag-auth _profiles 2>/dev/null)
            COMPREPLY=($(compgen -W "$profiles $flags" -- "$cur"))
        else
            COMPREPLY=($(compgen -W "$commands $flags" -- "$cur"))
        fi
        return 0
    fi

    case "$prev" in
        switch|quota|delete|use|rm)
            local profiles=$(ag-auth _profiles 2>/dev/null)
            COMPREPLY=($(compgen -W "$profiles $flags" -- "$cur"))
            return 0
            ;;
        db)
            COMPREPLY=($(compgen -W "$db_cmds" -- "$cur"))
            return 0
            ;;
        --surface|-s)
            COMPREPLY=($(compgen -W "$surfaces" -- "$cur"))
            return 0
            ;;
        completion)
            COMPREPLY=($(compgen -W "bash zsh fish powershell install" -- "$cur"))
            return 0
            ;;
        *)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=($(compgen -W "$flags" -- "$cur"))
            else
                local profiles=$(ag-auth _profiles 2>/dev/null)
                COMPREPLY=($(compgen -W "$profiles" -- "$cur"))
            fi
            return 0
            ;;
    esac
}
complete -F _ag_auth_completions ag-auth
complete -F _ag_auth_completions @
EOF
            ;;
        zsh)
            cat << 'EOF'
#compdef ag-auth @

_ag_auth() {
    local -a commands
    commands=(
        'switch:Switch active Antigravity account (interactive arrow picker or direct email)'
        'quota:Display real-time AI quota dashboard (Gemini & Claude limits)'
        'list:List all vaulted profiles with inline quota bars'
        'current:Show currently active session, storage source, and limits'
        'save:Archive current session to vault (auto-detects email)'
        'detach:Stash active session & clear token for clean second login'
        'delete:Remove a profile from vault'
        'db:Cloud Database & Team Vault Sync (setup, status, push, pull, sync)'
        'completion:Generate shell autocompletion script (bash, zsh, fish, powershell)'
        'version:Show version information'
        'help:Show help message'
    )

    local -a profiles
    profiles=(${(f)"$(ag-auth _profiles 2>/dev/null)"})

    local -a db_cmds
    db_cmds=(
        'setup:Connect Supabase, shared folder, or REST database'
        'status:Check connection health and remote profile count'
        'push:Encrypt and push local profiles to team vault'
        'pull:Pull and decrypt team profiles into local vault'
        'sync:Two-way synchronization (push local + pull remote)'
        'disconnect:Safely unlink remote database'
    )

    _arguments -C \
        '(-s --surface)'{-s,--surface}'[Target runtime surface]:surface:(all cli ide app)' \
        '(-r --refresh -f --force)'{-r,--refresh,-f,--force}'[Force bypass cache and fetch live data]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '1: :->command' \
        '2: :->argument' \
        '*:: :->args'

    case $state in
        command)
            if [[ "$words[1]" == "@" ]]; then
                _describe -t profiles 'Vaulted Profiles' profiles
            else
                _describe -t commands 'ag-auth commands' commands
            fi
            ;;
        argument)
            case $words[2] in
                switch|quota|delete|use|rm)
                    _describe -t profiles 'Vaulted Profiles' profiles
                    ;;
                db)
                    _describe -t db_cmds 'Database Commands' db_cmds
                    ;;
                completion)
                    local -a shells
                    shells=('bash' 'zsh' 'fish' 'powershell' 'install')
                    _describe -t shells 'Shell' shells
                    ;;
            esac
            ;;
    esac
}

if (( $+functions[compdef] )); then
    compdef _ag_auth ag-auth
    compdef _ag_auth @
fi
EOF
            ;;
        fish)
            cat << 'EOF'
complete -c ag-auth -f
complete -c @ -f

set -l commands switch quota list current save detach delete db completion version help
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "switch" -d "Switch active account"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "quota" -d "View AI quota dashboard"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "list" -d "List all vaulted profiles"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "current" -d "Show current session"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "save" -d "Save session to vault"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "detach" -d "Detach session for new login"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "delete" -d "Delete profile from vault"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "db" -d "Cloud Database & Team Sync"
complete -c ag-auth -n "not __fish_seen_subcommand_from $commands" -a "completion" -d "Shell completion generator"

complete -c ag-auth -n "__fish_seen_subcommand_from switch quota delete" -a "(ag-auth _profiles 2>/dev/null)"
complete -c ag-auth -n "__fish_seen_subcommand_from db" -a "setup status push pull sync disconnect"
complete -c @ -a "(ag-auth _profiles 2>/dev/null)"
EOF
            ;;
        powershell)
            cat << 'EOF'
Register-ArgumentCompleter -Native -CommandName 'ag-auth', '@' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    $commands = @('switch', 'quota', 'list', 'current', 'save', 'detach', 'delete', 'db', 'completion', 'version', 'help')
    $db_cmds = @('setup', 'status', 'push', 'pull', 'sync', 'disconnect')
    $profiles = @(ag-auth _profiles 2>$null)
    $elements = $commandAst.Elements

    if ($elements.Count -le 2) {
        $commands | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
            [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
        }
    } else {
        $sub = $elements[1].Extent.Text
        if ($sub -in @('switch', 'quota', 'delete', '@')) {
            $profiles | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
                [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
            }
        } elseif ($sub -eq 'db') {
            $db_cmds | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
                [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
            }
        }
    }
}
EOF
            ;;
        install)
            local cur_shell="$(basename "${SHELL:-bash}")"
            echo -e "${CYAN}Installing tab autocompletion for shell: ${BOLD}${cur_shell}${NC}..."
            case "${cur_shell}" in
                zsh)
                    local rc="${HOME}/.zshrc"
                    mkdir -p "${HOME}/.zfunc"
                    cmd_completion zsh > "${HOME}/.zfunc/_ag-auth"
                    if ! grep -q "fpath=(~/.zfunc \$fpath)" "${rc}" 2>/dev/null; then
                        echo -e '\nfpath=(~/.zfunc $fpath)\nautoload -Uz compinit && compinit' >> "${rc}"
                    fi
                    echo -e "${GREEN}✔ Zsh completions installed to ~/.zfunc/_ag-auth and registered in ~/.zshrc${NC}"
                    echo -e "Run: ${BOLD}source ~/.zshrc${NC} or restart your shell to activate tab completion."
                    ;;
                bash)
                    local rc="${HOME}/.bashrc"
                    [[ -f "${HOME}/.bash_profile" ]] && rc="${HOME}/.bash_profile"
                    local comp_file="${HOME}/.ag-auth-completion.bash"
                    cmd_completion bash > "${comp_file}"
                    if ! grep -q "source.*ag-auth-completion.bash" "${rc}" 2>/dev/null; then
                        echo -e "\n[ -f \"${comp_file}\" ] && source \"${comp_file}\"" >> "${rc}"
                    fi
                    echo -e "${GREEN}✔ Bash completions saved to ${comp_file} and registered in ${rc}${NC}"
                    echo -e "Run: ${BOLD}source ${rc}${NC} or restart your shell to activate tab completion."
                    ;;
                fish)
                    local fish_dir="${HOME}/.config/fish/completions"
                    mkdir -p "${fish_dir}"
                    cmd_completion fish > "${fish_dir}/ag-auth.fish"
                    cmd_completion fish > "${fish_dir}/@.fish"
                    echo -e "${GREEN}✔ Fish completions installed to ${fish_dir}/ag-auth.fish${NC}"
                    ;;
                *)
                    echo -e "${YELLOW}Could not auto-determine configuration file for ${cur_shell}.${NC}"
                    echo "Please run: 'eval \"\$(ag-auth completion ${cur_shell})\"' in your shell profile."
                    ;;
            esac
            ;;
        *)
            echo "Usage: ag-auth completion [bash|zsh|fish|powershell|install]"
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 7. Interactive Master Menu
# ------------------------------------------------------------------------------
cmd_interactive() {
    echo -e "${BOLD}${MAGENTA}========================================${NC}"
    echo -e "${BOLD}${MAGENTA}  Universal Antigravity Vault (${VERSION})  ${NC}"
    echo -e "${BOLD}${MAGENTA}  macOS • Linux • Windows (CLI, IDE, 2.0)${NC}"
    echo -e "${BOLD}${MAGENTA}========================================${NC}"
    echo ""
    cmd_current
    echo ""
    echo -e "${BOLD}Actions:${NC}"
    echo "  1) Save current session to vault (CLI + IDE + 2.0 Desktop)"
    echo "  2) Switch account (↑ / ↓ arrow selection with live quota)"
    echo "  3) View AI quota dashboard (Gemini & Claude limits)"
    echo "  4) List all saved profiles with quotas"
    echo "  5) Detach current session (prepare for new account login)"
    echo "  6) Cloud Database & Team Vault Sync (Supabase / Team Drive)"
    echo "  7) Install Tab Autocompletion (lazy programmer mode)"
    echo "  8) Delete a profile from vault"
    echo "  9) Exit"
    echo ""
    read -rp "Select an option [1-9]: " choice
    case "${choice}" in
        1)
            read -rp "Enter profile name (press Enter to auto-detect email): " name
            cmd_save "${name}"
            ;;
        2)
            echo ""
            local selected
            selected=$(pick_profile_interactive)
            if [[ -n "${selected}" ]]; then
                cmd_switch "${selected}" "all"
            fi
            ;;
        3)
            echo ""
            cmd_quota "" false
            ;;
        4)
            echo ""
            cmd_list false
            ;;
        5)
            cmd_detach "all"
            ;;
        6)
            echo ""
            echo "Team Vault & Cloud Database:"
            echo "  1) Sync accounts (Two-way Push & Pull)"
            echo "  2) Push local accounts to cloud"
            echo "  3) Pull team accounts from cloud"
            echo "  4) Check database connection status"
            echo "  5) Setup / Connect database"
            echo "  6) Disconnect database"
            read -rp "Select [1-6]: " db_choice
            case "${db_choice}" in
                1) cmd_db sync ;;
                2) cmd_db push ;;
                3) cmd_db pull ;;
                4) cmd_db status ;;
                5) cmd_db setup ;;
                6) cmd_db disconnect ;;
                *) echo "Cancelled." ;;
            esac
            ;;
        7)
            cmd_completion install
            ;;
        8)
            echo ""
            local target
            target=$(pick_profile_interactive)
            if [[ -n "${target}" ]]; then
                cmd_delete "${target}"
            fi
            ;;
        9)
            echo "Goodbye!"
            exit 0
            ;;
        *)
            echo -e "${RED}Invalid selection.${NC}"
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# 8. Command Line Dispatcher
# ------------------------------------------------------------------------------
# Quick check if executed as '@' or '#' directly
BASE_CMD="$(basename "$0")"
if [[ "${BASE_CMD}" == "@" || "${BASE_CMD}" == "#" ]]; then
    cmd_switch "${1:-}" "all"
    exit 0
fi

# Parse global flags (--surface / -s)
SURFACE="all"
FILTERED_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --surface|-s)
            SURFACE="$2"
            shift 2
            ;;
        --surface=*)
            SURFACE="${1#*=}"
            shift
            ;;
        *)
            FILTERED_ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${FILTERED_ARGS[@]:-}"

case "${1:-}" in
    "@"|"#"|"select"|"sw")
        cmd_switch "${2:-}" "${SURFACE}"
        ;;
    current|status|whoami)
        cmd_current
        ;;
    save)
        cmd_save "${2:-}"
        ;;
    list|ls)
        REFRESH_FLAG=false
        for arg in "${@:2}"; do
            if [[ "$arg" == "--refresh" || "$arg" == "-r" || "$arg" == "--force" || "$arg" == "-f" ]]; then
                REFRESH_FLAG=true
            fi
        done
        cmd_list "${REFRESH_FLAG}"
        ;;
    quota|limits|usage)
        REFRESH_FLAG=false
        TARGET_PROF=""
        for arg in "${@:2}"; do
            if [[ "$arg" == "--refresh" || "$arg" == "-r" || "$arg" == "--force" || "$arg" == "-f" ]]; then
                REFRESH_FLAG=true
            elif [[ -z "$TARGET_PROF" && "$arg" != -* ]]; then
                TARGET_PROF="$arg"
            fi
        done
        cmd_quota "${TARGET_PROF}" "${REFRESH_FLAG}"
        ;;
    detach|new|logout-temp)
        cmd_detach "${SURFACE}"
        ;;
    switch|use)
        cmd_switch "${2:-}" "${SURFACE}"
        ;;
    delete|rm)
        cmd_delete "${2:-}"
        ;;
    db|sync-db|cloud)
        cmd_db "${2:-status}"
        ;;
    _profiles)
        cmd_profiles
        ;;
    completion)
        cmd_completion "${2:-}"
        ;;
    version|-v|--version)
        echo "Universal ag-auth version ${VERSION} (${PLATFORM})"
        ;;
    help|--help|-h)
        echo -e "${BOLD}ag-auth${NC} - Universal Antigravity Multi-Account Session Vault (CLI, IDE, 2.0 Desktop)"
        echo ""
        echo -e "${BOLD}Usage:${NC}"
        echo "  @                           Instant interactive account switcher with live quota (↑/↓ + Enter)"
        echo "  @ <profile>                 Directly switch to an account by email"
        echo "  ag-auth switch              Interactive arrow-key account selector"
        echo "  ag-auth switch <profile>    Switch all surfaces (CLI, IDE, 2.0 App)"
        echo "  ag-auth switch <profile> -s ide   Switch only Antigravity IDE"
        echo "  ag-auth switch <profile> -s app   Switch only Antigravity 2.0 Desktop"
        echo "  ag-auth switch <profile> -s cli   Switch only Antigravity CLI"
        echo "  ag-auth quota [--refresh]   Display detailed AI quota dashboard (Gemini & Claude limits)"
        echo "  ag-auth quota <profile>     Display AI quota for a specific profile"
        echo "  ag-auth list [--refresh]    List all stored profiles with inline quota bars"
        echo "  ag-auth current             Show active account, runtime surfaces, and limits"
        echo "  ag-auth save [name]         Archive current session (auto-captures CLI + IDE + 2.0)"
        echo "  ag-auth detach [-s surface] Stash active session & clear tokens for clean login"
        echo "  ag-auth delete [profile]    Remove a profile from vault"
        echo ""
        echo -e "${BOLD}Team Vault & Cloud Database:${NC}"
        echo "  ag-auth db setup            Interactive setup wizard (Supabase, Drive, Custom REST)"
        echo "  ag-auth db status           Check connection health & count of remote team accounts"
        echo "  ag-auth db push             Encrypt and upload local accounts to team database"
        echo "  ag-auth db pull             Download and decrypt team accounts into local vault"
        echo "  ag-auth db sync             Two-way sync (push local accounts + pull team accounts)"
        echo "  ag-auth db disconnect       Unlink remote database (local accounts are kept intact)"
        echo ""
        echo -e "${BOLD}Shell Autocompletion:${NC}"
        echo "  ag-auth completion install  Install tab autocompletion for bash, zsh, fish, powershell"
        echo "  ag-auth                     Launch full interactive menu"
        echo ""
        echo -e "${BOLD}Examples:${NC}"
        echo "  @                           # Instant switch with arrow keys and live quotas!"
        echo "  ag-auth switch <TAB>        # Tab auto-fill accounts (lazy programmer mode)!"
        echo "  ag-auth db sync             # Sync and pool accounts across all team members"
        echo "  ag-auth quota --refresh     # Live AI limits with reset countdowns"
        echo "  ag-auth completion install  # One-step tab completion setup"
        ;;
    *)
        if [[ -z "${1:-}" ]]; then
            cmd_interactive
        else
            echo -e "${RED}Unknown command:${NC} $1"
            echo "Run 'ag-auth help' for all commands."
            exit 1
        fi
        ;;
esac
